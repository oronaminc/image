<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.oronaminc.imagecollector.viewer</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/1113177/Desktop/github/image/.venv/bin/python</string>
        <string>-m</string>
        <string>imagecollector</string>
        <string>serve</string>
        <string>--host</string>
        <string>127.0.0.1</string>
        <string>--port</string>
        <string>8765</string>
