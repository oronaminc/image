# =====================================================================
#  API 키 (선택 사항)
#  - Openverse / Wikimedia 는 키 없이도 동작합니다.
#  - 아래 키를 넣으면 해당 소스와 더 높은 호출 한도를 사용할 수 있습니다.
#  - 이 파일을 복사해서 `.env` 로 저장하고 값을 채우세요.
# =====================================================================

# Openverse (선택): 익명으로도 되지만, 클라이언트 등록 시 rate limit 이 크게 올라갑니다.
#   등록: https://api.openverse.org/v1/#tag/auth
OPENVERSE_CLIENT_ID=
OPENVERSE_CLIENT_SECRET=

# Pexels (무료 키): https://www.pexels.com/api/
PEXELS_API_KEY=

# Pixabay (무료 키): https://pixabay.com/api/docs/
PIXABAY_API_KEY=

# Unsplash (무료 키): https://unsplash.com/developers
#   주의: Unsplash 는 사진 자체는 상업적 사용 가능하나, API 이용약관상
#   'hotlink' 및 다운로드 트리거 등 가이드라인 준수가 필요합니다. README 참고.
UNSPLASH_ACCESS_KEY=
